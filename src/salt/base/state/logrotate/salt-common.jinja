/var/log/salt/master {
        maxsize 10M
        weekly
        missingok
        rotate 7
        compress
        notifempty
}

/var/log/salt/minion {
        maxsize 200M
        daily
        missingok
        rotate 7
        compress
        notifempty
}

/var/log/salt/key {
        maxsize 10M
        weekly
        missingok
        rotate 7
        compress
        notifempty
}
